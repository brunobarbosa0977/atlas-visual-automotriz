{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/optimized/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/upsell",
      "destination": "/upsell.html"
    },
    {
      "source": "/downsell",
      "destination": "/downsell.html"
    },
    {
      "source": "/gracias",
      "destination": "/gracias.html"
    },
    {
      "source": "/gracias-vip",
      "destination": "/gracias-vip.html"
    }
  ]
}
